<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml ~ go.mod
  - groupId/artifactId ~ module path (gitlab.viettelcyber.com/x-hunting/golang-common)
  - <dependencies> ~ require (...)
  - Khác Go: Maven còn quản lý luôn vòng đời build (compile -> test -> package),
    tương tự gộp "go build" + "go test" + Makefile vào một chỗ.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xhunting</groupId>
    <artifactId>xhunting-extractors</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- Chỉ dùng thư viện chuẩn của JDK cho code chính. JUnit chỉ dùng cho test (~ package testing của Go). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <!-- Ghi Main-Class vào jar để chạy được bằng: java -jar target/xhunting-extractors-0.1.0.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.xhunting.extractors.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
